# Copie para .env e preencha.

# Banco hospedado (Supabase). Pegue a connection string em:
# Supabase > Project Settings > Database > Connection string (URI).
# Deixe VAZIO para operar offline (dados so no manifesto local).
DATABASE_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Pasta dos manifestos locais (dentro do container)
MANIFEST_DIR=/app/manifestos
